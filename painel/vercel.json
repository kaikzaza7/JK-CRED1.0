{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://cluxbeysuboablzeawnm.supabase.co wss://cluxbeysuboablzeawnm.supabase.co; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ],
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/gateway.mjs": {
      "maxDuration": 60
    },
    "api/notifications.mjs": {
      "maxDuration": 60
    },
    "api/notification-cron.mjs": {
      "maxDuration": 60
    },
    "api/pool.mjs": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/notification-cron",
      "schedule": "0 11 * * *"
    }
  ]
}
